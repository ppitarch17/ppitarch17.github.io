---
import { pipeline, mcp as mcpData, local as localData } from '../data/ai';
import { getLang } from '../i18n';

const lang = getLang(Astro.currentLocale);
const t = {
  en: {
    title: 'How I work with AI',
    intro: 'I plan the work, hand each piece to the right agent and model, and check what comes back before it ships.',
  },
  es: {
    title: 'Cómo trabajo con IA',
    intro: 'Planifico el trabajo, doy cada parte al agente y al modelo adecuados, y reviso lo que vuelve antes de entregarlo.',
  },
}[lang];

const flow = pipeline[lang];
const mcp = mcpData[lang];
const local = localData[lang];

// Node colours (literal class names so Tailwind picks them up)
const nodeClass = {
  human: 'fill-red/10 stroke-red',
  agent: 'fill-blue/10 stroke-blue',
  none: 'fill-on-band/10 stroke-on-band/50',
};

// Edges, in order: from -> to. The run walks them in `seq`: the reviewer can send the work back to the coder (e4), so e3 is travelled twice.
const edgeLinks = [
  [0, 1],
  [1, 2],
  [2, 3],
  [3, 4],
  [4, 3], // retry: back to the coder
  [4, 5], // exit to my check
];
const seq = [0, 1, 2, 3, 4, 3, 5];

// Wide layout: six nodes in a row, the retry arc swings underneath nodes 4 and 3
const NW = 124;
const NH = 56;
const hx = (i: number) => i * 167;
const hy = 20;
const hcy = hy + NH / 2;
const wide = {
  vb: '0 0 959 150',
  nodes: flow.nodes.map((n, i) => ({ ...n, x: hx(i), y: hy, w: NW, h: NH, tx: hx(i) + NW / 2, ty: hcy + 5, anchor: 'middle' })),
  edges: [
    ...[0, 1, 2, 3].map((i) => `M ${hx(i) + NW + 4} ${hcy} L ${hx(i + 1) - 5} ${hcy}`),
    `M ${hx(4) + NW / 2} ${hy + NH + 4} C ${hx(4) + NW / 2} 140, ${hx(3) + NW / 2} 140, ${hx(3) + NW / 2} ${hy + NH + 5}`,
    `M ${hx(4) + NW + 4} ${hcy} L ${hx(5) - 5} ${hcy}`,
  ],
};

// Narrow layout: the same six nodes stacked, the retry arc on the right between nodes 4 and 3
const VW = 200;
const VH = 48;
const vx = 20;
const vy = (i: number) => 8 + i * 80;
const vcx = vx + VW / 2;
const narrow = {
  vb: '0 0 340 464',
  nodes: flow.nodes.map((n, i) => ({ ...n, x: vx, y: vy(i), w: VW, h: VH, tx: vx + 16, ty: vy(i) + 30, anchor: 'start' })),
  edges: [
    ...[0, 1, 2, 3].map((i) => `M ${vcx} ${vy(i) + VH + 4} L ${vcx} ${vy(i + 1) - 5}`),
    `M ${vx + VW + 4} ${vy(4) + VH / 2} C 318 ${vy(4) + VH / 2}, 318 ${vy(3) + VH / 2}, ${vx + VW + 5} ${vy(3) + VH / 2}`,
    `M ${vcx} ${vy(4) + VH + 4} L ${vcx} ${vy(5) - 5}`,
  ],
};

const layouts = [
  { id: 'wide', cls: 'hidden w-full lg:block', ...wide },
  { id: 'narrow', cls: 'mx-auto block w-full max-w-[380px] lg:hidden', ...narrow },
];

const chip = 'rounded border border-on-band/25 px-2 py-0.5 font-mono text-[0.8rem] text-on-band/85 [overflow-wrap:anywhere]';
---

<section id="ai" class="relative z-10 bg-band py-24 text-on-band md:py-32">
  <div class="wrap">
    <div class="max-w-[60ch]">
      <h2 class="display text-[clamp(2rem,4.2vw,3.6rem)] [--wdth:112] [--wght:800]">{t.title}</h2>
      <p class="mt-5 max-w-[46ch] text-lg leading-relaxed text-on-band/85">
        {t.intro}
      </p>
    </div>

    <figure class="mt-14 md:mt-16">
      <div>
        {
          layouts.map((l) => (
            <svg
              class:list={['agent-loop', l.cls]}
              data-layout={l.id}
              data-seq={seq.join(',')}
              viewBox={l.vb}
              role="img"
              aria-label={flow.label}
              xmlns="http://www.w3.org/2000/svg"
            >
              <defs>
                <marker id={`loop-arrow-${l.id}`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                  <path d="M1 1 L9 5 L1 9 Z" class="fill-on-band/55" />
                </marker>
              </defs>

              {l.edges.map((d) => (
                <path d={d} fill="none" stroke-width="2" stroke-linecap="round" class="stroke-on-band/25" marker-end={`url(#loop-arrow-${l.id})`} />
              ))}
              {l.edges.map((d, i) => (
                <path d={d} fill="none" stroke-width="2.5" stroke-linecap="round" class="loop-edge stroke-on-band/90" data-from={edgeLinks[i][0]} data-to={edgeLinks[i][1]} />
              ))}

              {l.nodes.map((n, i) => (
                <g class="loop-node" data-node={i}>
                  <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="6" stroke-width="1.5" class={nodeClass[n.who]} />
                  <text x={n.tx} y={n.ty} text-anchor={n.anchor} class="loop-title fill-on-band text-[15px]">
                    {n.title}
                  </text>
                </g>
              ))}

              <circle class="loop-dot fill-on-band/25" r="14" cx={l.nodes[0].x} cy={l.nodes[0].y} />
              <circle class="loop-dot fill-on-band" r="6" cx={l.nodes[0].x} cy={l.nodes[0].y} />
            </svg>
          ))
        }
      </div>

      <figcaption class="mt-8">
        <dl class="grid gap-x-8 gap-y-5 sm:grid-cols-2 lg:grid-cols-4">
          {
            flow.roles.map((r) => (
              <div class="border-t border-on-band/20 pt-3">
                <dt class="text-sm font-semibold text-on-band/70">{r.title}</dt>
                <dd class="mt-1 text-[0.95rem] leading-snug text-on-band/85">{r.text}</dd>
              </div>
            ))
          }
        </dl>

        <div class="mt-8 flex flex-col gap-3 lg:flex-row lg:items-baseline lg:gap-8">
          <p class="shrink-0 text-sm font-semibold text-on-band/70">{flow.tiersLabel}</p>
          <ul class="grid flex-1 gap-3 sm:grid-cols-3 sm:gap-6">
            {
              flow.tiers.map((tier) => (
                <li class="text-[0.95rem] leading-snug text-on-band/85">
                  <span class="display mr-2 text-on-band [--wdth:95] [--wght:700]">{tier.name}</span>{' '}
                  {tier.text}
                </li>
              ))
            }
          </ul>
        </div>
      </figcaption>
    </figure>

    <ul class="mt-14 grid gap-10 md:mt-16 lg:grid-cols-[1.6fr_1fr] lg:gap-14">
      <li class="ai-item min-w-0 border-t border-on-band/20 pt-5">
        <h3 class="display text-[clamp(1.4rem,2.2vw,1.8rem)] leading-[1.05] [--wdth:95] [--wght:700]">{mcp.title}</h3>
        <p class="mt-3 text-on-band/85">{mcp.text}</p>
        <ul class="mt-4 flex flex-wrap items-center gap-2">
          {mcp.tools.map((name) => <li class={chip}>{name}</li>)}
          <li class="text-[0.95rem] text-on-band/85">{mcp.more}</li>
        </ul>
        <p class="mt-5 text-on-band/85">
          <span class="text-sm font-semibold text-on-band/70">{mcp.exampleLabel}</span>{' '}
          {mcp.example.map((s) => (s.code ? <span class="font-mono text-[0.9em] [overflow-wrap:anywhere]">{s.t}</span> : s.t))}
        </p>
        <a href={mcp.link.href} class="mt-3 inline-block text-[0.95rem] underline decoration-red decoration-2 underline-offset-4 hover:text-red">
          {mcp.link.label} ↑
        </a>
      </li>
      <li class="ai-item min-w-0 border-t border-on-band/20 pt-5">
        <h3 class="display text-[clamp(1.4rem,2.2vw,1.8rem)] leading-[1.05] [--wdth:95] [--wght:700]">{local.title}</h3>
        <p class="mt-3 text-on-band/85">{local.text}</p>
      </li>
    </ul>
  </div>
</section>
