---
import { getLang, homePath } from '../i18n';

const lang = getLang(Astro.currentLocale);
const other = lang === 'en' ? 'es' : 'en';

const t = {
  en: { about: 'About', experience: 'Experience', projects: 'Projects', ai: 'AI', contact: 'Contact', main: 'Main', switchTo: 'Ver en español', theme: 'Dark mode', menu: 'Menu' },
  es: { about: 'Sobre mí', experience: 'Experiencia', projects: 'Proyectos', ai: 'IA', contact: 'Contacto', main: 'Principal', switchTo: 'View in English', theme: 'Modo oscuro', menu: 'Menú' },
}[lang];

const links = [
  { href: '#about', label: t.about },
  { href: '#laps', label: t.experience },
  { href: '#proyecta', label: t.projects },
  { href: '#ai', label: t.ai },
  { href: '#contact', label: t.contact },
];
---

<header id="nav" class="fixed inset-x-0 top-0 z-40 bg-paper/85 backdrop-blur-md transition-transform duration-500">
  <nav class="flex items-center justify-between gap-2 px-3 py-4 min-[380px]:gap-4 min-[380px]:px-4 md:px-10" aria-label={t.main}>
    <a href="#top" class="display text-base whitespace-nowrap no-underline [--wdth:120] [--wght:800] min-[380px]:text-lg">Pablo Pitarch</a>
    <div class="flex items-center gap-2 min-[380px]:gap-4 md:gap-7">
      <ul class="hidden gap-4 text-sm sm:flex md:gap-7 md:text-base">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="nav-link no-underline hover:underline">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href={homePath[other]}
        hreflang={other}
        lang={other}
        class="rounded-full border border-ink/25 px-2.5 py-0.5 text-xs font-semibold uppercase no-underline transition-colors hover:border-red hover:text-red md:text-sm"
        aria-label={t.switchTo}
        title={t.switchTo}
      >
        {other}
      </a>
      <button
        type="button"
        id="theme-toggle"
        class="flex h-8 w-8 items-center justify-center rounded-full border border-ink/25 transition-colors hover:border-red hover:text-red"
        aria-label={t.theme}
        title={t.theme}
        aria-pressed="false"
      >
        <svg class="theme-icon-moon h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
        <svg class="theme-icon-sun h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>
      <button
        type="button"
        id="menu-toggle"
        class="flex h-8 w-8 items-center justify-center rounded-full border border-ink/25 transition-colors hover:border-red hover:text-red sm:hidden"
        aria-label={t.menu}
        title={t.menu}
        aria-expanded="false"
        aria-controls="menu-panel"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </nav>
  <div
    id="menu-panel"
    class="invisible absolute inset-x-0 top-full -translate-y-2 border-t border-ink/10 bg-paper opacity-0 transition-[opacity,transform,visibility] duration-200 motion-reduce:transition-none sm:hidden data-[open]:visible data-[open]:translate-y-0 data-[open]:opacity-100"
  >
    <ul class="px-4 py-2">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="display block py-4 text-2xl no-underline [--wdth:110] [--wght:700] hover:text-red">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>
