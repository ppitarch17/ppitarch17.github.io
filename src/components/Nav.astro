---
const links = [
  { href: '#about', label: 'About' },
  { href: '#laps', label: 'Experience' },
  { href: '#ujiert', label: 'Projects' },
  { href: '#ai', label: 'AI' },
  { href: '#contact', label: 'Contact' },
];
---

<header id="nav" class="fixed inset-x-0 top-0 z-40 bg-paper/85 backdrop-blur-md transition-transform duration-500">
  <nav class="flex items-center justify-between px-4 py-4 md:px-10" aria-label="Main">
    <a href="#top" class="display text-lg whitespace-nowrap no-underline [--wdth:120] [--wght:800]">Pablo Pitarch</a>
    <ul class="flex gap-4 text-sm md:gap-7 md:text-base">
      {
        links.map((l, i) => (
          <li class:list={[i === 1 || i === 3 ? 'hidden sm:block' : '']}>
            <a href={l.href} class="nav-link no-underline hover:underline">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
