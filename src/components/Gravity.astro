---
import { Image } from 'astro:assets';
import puzzle from '../assets/puzle.png';
import { getLang } from '../i18n';

const t = {
  en: {
    flipLabel: 'Flip gravity in the game screenshot',
    alt: 'Gravity Puzzle: a small character in a stone castle level',
    subtitle: 'University project, 2022',
    text: 'A 2.5D platformer made in Unity, where you solve each level by flipping gravity.',
    flip: 'Flip gravity',
    code: 'Read the code',
  },
  es: {
    flipLabel: 'Invertir la gravedad en la captura del juego',
    alt: 'Gravity Puzzle: un pequeño personaje en un nivel de castillo de piedra',
    subtitle: 'Proyecto universitario, 2022',
    text: 'Un plataformas 2.5D hecho en Unity, donde resuelves cada nivel invirtiendo la gravedad.',
    flip: 'Invertir la gravedad',
    code: 'Ver el código',
  },
}[getLang(Astro.currentLocale)];
---

<section id="gravity" class="relative py-16 md:py-24">
  <div class="wrap flex flex-col gap-8 sm:flex-row sm:items-center sm:gap-12">
    <button
      type="button"
      class="gravity-flip block w-full max-w-[340px] shrink-0 overflow-hidden rounded-[4px]"
      aria-label={t.flipLabel}
    >
      <Image
        id="gravity-img"
        src={puzzle}
        alt={t.alt}
        widths={[340, 680]}
        sizes="340px"
        class="aspect-[16/10] w-full object-cover"
      />
    </button>

    <div>
      <h2 id="gravity-title" class="display text-[clamp(1.6rem,2.8vw,2.4rem)] [--wdth:100] [--wght:800]">Gravity Puzzle</h2>
      <p class="mt-1 text-sm text-steel">{t.subtitle}</p>
      <p class="mt-3 max-w-[44ch]">{t.text}</p>
      <p class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
        <button type="button" class="gravity-flip font-semibold underline decoration-red decoration-2 underline-offset-4">{t.flip}</button>
        <a href="https://github.com/ppitarch17/marmotas" target="_blank" rel="noopener" class="underline underline-offset-4">{t.code}</a>
      </p>
    </div>
  </div>
</section>
