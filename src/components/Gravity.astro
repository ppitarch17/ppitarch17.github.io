---
import { Image } from 'astro:assets';
import puzzle from '../assets/puzle.png';
---

<section id="gravity" class="relative py-16 md:py-24">
  <div class="wrap flex flex-col gap-8 sm:flex-row sm:items-center sm:gap-12">
    <button
      type="button"
      class="gravity-flip block w-full max-w-[340px] shrink-0 overflow-hidden rounded-[4px]"
      aria-label="Flip gravity in the game screenshot"
    >
      <Image
        id="gravity-img"
        src={puzzle}
        alt="Gravity Puzzle: a small character in a stone castle level"
        widths={[340, 680]}
        sizes="340px"
        class="aspect-[16/10] w-full object-cover"
      />
    </button>

    <div>
      <h2 id="gravity-title" class="display text-[clamp(1.6rem,2.8vw,2.4rem)] [--wdth:100] [--wght:800]">Gravity Puzzle</h2>
      <p class="mt-1 text-sm text-steel">University project, 2022</p>
      <p class="mt-3 max-w-[44ch]">A 2.5D platformer made in Unity, where you solve each level by flipping gravity.</p>
      <p class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
        <button type="button" class="gravity-flip font-semibold underline decoration-red decoration-2 underline-offset-4">Flip gravity</button>
        <a href="https://github.com/ppitarch17/marmotas" target="_blank" rel="noopener" class="underline underline-offset-4">Read the code</a>
      </p>
    </div>
  </div>
</section>
