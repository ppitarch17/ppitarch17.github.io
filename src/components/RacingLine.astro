<!-- The racing line: a path through the right gutter, drawn as you scroll. Built in main.ts once layout is known. -->
<svg id="racing-line" class="pointer-events-none absolute top-0 left-0 z-0 hidden text-ink lg:block" aria-hidden="true">
  <path id="line-ghost" fill="none" stroke="currentColor" stroke-opacity="0.12" stroke-width="2" stroke-dasharray="2 8" stroke-linecap="round"></path>
  <path id="line-drawn" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path>
  <circle id="line-car" r="7" fill="#e13b2e"></circle>
</svg>
