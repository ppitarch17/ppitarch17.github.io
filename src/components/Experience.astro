---
import { experience } from '../data/experience';
---

<section id="laps" class="relative z-10 overflow-hidden bg-paper-2">
  <div class="kerb origin-left" id="kerb" aria-hidden="true"></div>
  <div class="laps-pin flex min-h-[100svh] flex-col justify-center py-20 lg:pt-24 lg:pb-10">
    <div class="wrap mb-12 lg:mb-16">
      <h2 class="display text-[clamp(2rem,4.2vw,3.6rem)] [--wdth:112] [--wght:800]">Experience</h2>
          </div>

    <div class="laps-viewport lg:overflow-visible">
      <ol id="laps-track" class="flex flex-col gap-12 px-4 md:px-10 lg:w-max lg:flex-row lg:gap-0 lg:pr-[20vw]">
        {
          experience.map((r, i) => (
            <li class="lap relative lg:w-[min(400px,30vw)] lg:shrink-0 lg:pr-12">
              <div class="relative mb-6 hidden h-4 lg:block" aria-hidden="true">
                <span class="absolute top-1/2 right-0 left-0 h-[2px] -translate-y-1/2 bg-ink/15" />
                <span class="lap-line absolute top-1/2 left-0 h-[2px] w-full origin-left -translate-y-1/2 scale-x-0 bg-ink" />
                <span class:list={['absolute top-1/2 left-0 h-4 w-4 -translate-y-1/2 rounded-full border-2 border-ink', r.current ? 'bg-red border-red' : 'bg-paper-2']} />
              </div>
              <p class="display text-[clamp(1.8rem,3vw,2.6rem)] text-ink [--wdth:75] [--wght:700]">{r.period.replace('—', '–')}</p>
              <h3 class="mt-3 text-lg font-semibold">
                {r.title}, {r.org}
              </h3>
              {r.place && <p class="text-steel">{r.place}</p>}
              <p class="text-steel">{r.summary}</p>
              <ul class="mt-3 space-y-1.5 text-[0.92rem] text-steel">
                {r.highlights.map((h) => (
                  <li class="relative pl-5 before:absolute before:top-[0.7em] before:left-0 before:h-[2px] before:w-2.5 before:bg-red">{h}</li>
                ))}
              </ul>
                            {i === 0 && <span class="sr-only">Current role</span>}
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
