---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import portrait from '../assets/IMG_8887.JPG';
import { getLang, homePath, langs } from '../i18n';

const lang = getLang(Astro.currentLocale);
const descriptions = {
  en: 'Pablo Pitarch builds Angular apps for public spaces, led telemetry for an electric race bike, and works with AI agents every day.',
  es: 'Pablo Pitarch desarrolla aplicaciones Angular para espacios públicos, dirigió la telemetría de una moto de carreras eléctrica y trabaja con agentes de IA a diario.',
};

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Pablo Pitarch', description = descriptions[lang] } = Astro.props;
const canonical = new URL(homePath[lang], Astro.site).href;

const og = await getImage({ src: portrait, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e9ecef" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(homePath[l], Astro.site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(homePath.en, Astro.site).href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anybody:wdth,wght@50..150,100..900&family=Carlito:wght@400;700&family=Instrument+Sans:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      // Set the theme before first paint: saved choice, else the system preference
      (function () {
        var theme = 'light';
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'dark' || saved === 'light') theme = saved;
          else if (matchMedia('(prefers-color-scheme: dark)').matches) theme = 'dark';
        } catch (e) {
          if (matchMedia('(prefers-color-scheme: dark)').matches) theme = 'dark';
        }
        document.documentElement.dataset.theme = theme;
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', theme === 'dark' ? '#0a0a0a' : '#e9ecef');
      })();
    </script>
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-anim');
        setTimeout(() => {
          if (!document.documentElement.dataset.ready) document.documentElement.classList.remove('js-anim');
        }, 4000);
      }
    </script>
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
